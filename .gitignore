__pycache__/
.venv/
.mypy_cache/
*.egg-info/
*.log
uv.lock

# Derived artifacts under artifacts/ — regenerate via pipeline, never track
artifacts/**/*.npy
artifacts/**/*.pth
artifacts/**/*.pt
artifacts/**/*.csv
artifacts/**/*.md
artifacts/**/*.png
artifacts/**/*.npz

# Exception: paper figures (small, hand-picked outputs for the paper)
!artifacts/final/paper_figures/*.png

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
